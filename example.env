# --------------------------------------------------------------------------- #
# WeKnora Forge - 本地开发环境变量模板
#
# 使用方法：复制为 .env 并填写实际值
#   cp example.env .env
#
# Forge 通过 config.json 管理配置，此文件仅承载 config.json 中通过 ${VAR}
# 引用的敏感值。详见 README.md "Configuration" 章节。
# --------------------------------------------------------------------------- #

# 配置目录（容器内默认 /data；目录内的 config.json 会被加载）
# 也可直接指向一个 config.json 文件以兼容旧用法
# FORGE_CONFIG=/data

# ------------------------------- Upstream ---------------------------------- #
# WeKnora 后台地址（本地开发填 localhost，Docker 环境填 host.docker.internal）
WEKNORA_BASE_URL=http://localhost:8080

# -------------------------- HMAC 二次签名密钥对 ----------------------------- #
# 本地环境测试用：X-Forge-Signature = hex(HMAC_SHA256(api_secret, METHOD + FULL_PATH))
# 生产部署可在 config.json 同目录（容器内 /data/keys.json）配置多组 api_key/api_secret；
# keys.json 中与 WEKNORA_API_KEY 相同的条目会覆盖这里的 WEKNORA_API_SECRET。
WEKNORA_API_KEY=
WEKNORA_API_SECRET=

# ---------------------------- PostgreSQL ----------------------------------- #
# 直连数据库配置，用于 Custom Metas 搜索和物理清除。
# 填写 FORGE_DB_DSN 可跳过下方 DB_* 分项（优先使用 DSN）。
FORGE_DB_DSN=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=WeKnora
# disable | allow | prefer | require | verify-ca | verify-full
DB_SSLMODE=disable

# ------------------------------- Swagger ----------------------------------- #
# Swagger UI 开关（本地开发建议开启，生产环境设为 false）
SWAGGER_ENABLED=true
