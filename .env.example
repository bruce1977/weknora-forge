# --------------------------------------------------------------------------- #
# WeKnora Forge - environment file (docker compose reads it automatically)
#
# Forge is configured by config.json; this file only carries the values that
# config.json deliberately leaves outside of version control, i.e. everything it
# references through a ${VAR} placeholder. See "Configuration" in README.md.
# --------------------------------------------------------------------------- #

# Path of the configuration file (default: <repo>/config.json)
FORGE_CONFIG=/app/config.json

# ------------------------------- Upstream ---------------------------------- #
# Base URL of the native WeKnora instance. Inside docker compose, reach a WeKnora
# running on the host through host.docker.internal (extra_hosts is configured).
# Plain HTTP is expected: put HTTPS in front of this service, not in front of it.
WEKNORA_BASE_URL=http://host.docker.internal:8080
# Server-held fallback credential; empty means every caller must send its own key
WEKNORA_DEFAULT_API_KEY=

# ---------------------------- PostgreSQL ----------------------------------- #
# Direct database access, used by the Custom Metas search and by purge.
# Leave FORGE_DB_DSN empty to build the DSN from the DB_* values below.
FORGE_DB_DSN=
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=WeKnora
# disable | allow | prefer | require | verify-ca | verify-full
DB_SSLMODE=disable
